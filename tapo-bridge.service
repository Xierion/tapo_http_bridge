[Unit]
Description=Tapo P100 HTTP bridge for Moonraker
After=network-online.target
Wants=network-online.target

[Service]
# Update for user: User, Group, WorkingDirectory, ExecStart
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/tapo_http_bridge
ExecStart=/home/pi/tapo_http_bridge/venv/bin/python3 /home/pi/tapo_http_bridge/app.py
Restart=on-failure
RestartSec=5

# Config file holds your Tapo account password - keep it locked down.
UMask=0077

[Install]
WantedBy=multi-user.target
