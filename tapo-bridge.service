[Unit]
Description=Tapo P100 HTTP bridge for Moonraker
After=network-online.target
Wants=network-online.target

[Service]
# Update for user: User, Group, WorkingDirectory, ExecStart
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/tapo_http_bridge
ExecStart=/home/pi/tapo_http_bridge/venv/bin/gunicorn \
    --workers 1 \
    --timeout 15 \
    --graceful-timeout 5 \
    --bind 127.0.0.1:5111 \
    --access-logfile - \
    --error-logfile - \
    app:app
Restart=on-failure
RestartSec=5

# Config file holds your Tapo account password - keep it locked down.
UMask=0077

[Install]
WantedBy=multi-user.target
